# ---------------------------------------------------------------------------
# Live-call deepfake detection backend
# Copy to `.env` and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Streaming detection provider credential. Server-side only.
# This value must never appear in extension code, HTML, JS, source maps
# or browser storage.
RESEMBLE_API_KEY=
RESEMBLE_STREAM_URL=wss://stream.resemble.ai/api/v1/detect/audio

# Provider selection: "resemble" (real) or "mock" (scripted, for plumbing only).
LIVE_CALL_PROVIDER=resemble

# Mock mode must be enabled explicitly. A missing API key does NOT silently
# fall back to the mock, because a scripted verdict must never be mistaken
# for a real detection result.
LIVE_CALL_MOCK_MODE=false

# Bind address. Keep on loopback unless real authentication and TLS exist.
LIVE_CALL_HOST=127.0.0.1
LIVE_CALL_PORT=8000

# Optional explicit WebSocket base advertised to the extension.
# Leave empty to derive ws://LIVE_CALL_HOST:LIVE_CALL_PORT
LIVE_CALL_PUBLIC_BASE_URL=

# Transport limits and backpressure
LIVE_CALL_MAX_FRAME_BYTES=16384
LIVE_CALL_SESSION_TIMEOUT_SECONDS=3600
LIVE_CALL_MAX_QUEUED_FRAMES=64
LIVE_CALL_MAX_DROPPED_FRAMES=200

# Provider handshake timeouts (seconds)
LIVE_CALL_CONNECT_TIMEOUT_SECONDS=10
LIVE_CALL_READY_TIMEOUT_SECONDS=15
LIVE_CALL_FINAL_TIMEOUT_SECONDS=10

# WebSocket origin allowlist (comma separated).
# An unpacked extension gets a new ID on each load, hence the wildcard default.
LIVE_CALL_ALLOWED_ORIGINS=chrome-extension://*,http://127.0.0.1,http://localhost

# Audio contract
LIVE_CALL_SAMPLE_RATE=16000
LIVE_CALL_CHANNELS=1
