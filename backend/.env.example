# ---------------------------------------------------------------------------
# Live-call deepfake detection backend
# Copy to `.env` and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Streaming detection provider credential. Server-side only.
# This value must never appear in extension code, HTML, JS, source maps
# or browser storage.
RESEMBLE_API_KEY=
RESEMBLE_STREAM_URL=wss://stream.resemble.ai/api/v1/detect/audio

# Provider selection:
#   local    - open-source model run in this process. No credential, no
#              credits, no network at call time. This is the default.
#   resemble - hosted streaming provider (needs RESEMBLE_API_KEY above)
#   mock     - scripted verdicts, for plumbing tests only
LIVE_CALL_PROVIDER=local

# ---------------------------------------------------------------------------
# Local open-source detector
# ---------------------------------------------------------------------------
# IMPORTANT: model choice does NOT transfer between TTS engines, and the
# wrong one is actively inverted rather than merely weak.
#
# Measured: the model that ranked BEST against VITS (AUC 0.889) scored
# AUC 0.009 against ElevenLabs output - it labelled a genuine human
# caller 'fake' in 4 of 5 windows and missed all 23 AI windows. The model
# that ranked WORST on VITS scored AUC 1.000 on ElevenLabs.
#
# So: benchmark against the engine you actually expect to face.
#
#   python scripts/benchmark_detectors.py --human-dir h --fake-dir ai
#
# and validate end to end on your own samples:
#
#   python scripts/detect_file.py my-ai-sample.wav --expect fake
LIVE_CALL_LOCAL_MODEL_ID=Shahzaib-Arshad/deepfake_audio_detection
LIVE_CALL_LOCAL_DEVICE=cpu
LIVE_CALL_LOCAL_WINDOW_SECONDS=4.0

# Decision threshold on P(fake). Calibration-dependent: tune it from the
# benchmark table, trading detections against false alarms.
LIVE_CALL_LOCAL_FAKE_THRESHOLD=0.5

# Voice-activity floor (RMS). Windows quieter than this are reported as
# skipped rather than labelled, so silence cannot raise an alert.
LIVE_CALL_LOCAL_MIN_RMS=0.005

# Only for a model whose own id2label is uninformative (e.g. LABEL_0/LABEL_1).
# Leave empty to use the model's declared labels, which is always safer.
# Example: LIVE_CALL_LOCAL_LABEL_OVERRIDE=0=fake,1=real
LIVE_CALL_LOCAL_LABEL_OVERRIDE=

# Mock mode must be enabled explicitly. A missing API key does NOT silently
# fall back to the mock, because a scripted verdict must never be mistaken
# for a real detection result.
LIVE_CALL_MOCK_MODE=false

# Bind address. Keep on loopback unless real authentication and TLS exist.
LIVE_CALL_HOST=127.0.0.1
LIVE_CALL_PORT=8000

# Optional explicit WebSocket base advertised to the extension.
# Leave empty to derive ws://LIVE_CALL_HOST:LIVE_CALL_PORT
LIVE_CALL_PUBLIC_BASE_URL=

# Transport limits and backpressure
LIVE_CALL_MAX_FRAME_BYTES=16384
LIVE_CALL_SESSION_TIMEOUT_SECONDS=3600
LIVE_CALL_MAX_QUEUED_FRAMES=64
LIVE_CALL_MAX_DROPPED_FRAMES=200

# Provider handshake timeouts (seconds)
LIVE_CALL_CONNECT_TIMEOUT_SECONDS=10
LIVE_CALL_READY_TIMEOUT_SECONDS=15
LIVE_CALL_FINAL_TIMEOUT_SECONDS=10

# WebSocket origin allowlist (comma separated).
# An unpacked extension gets a new ID on each load, hence the wildcard default.
LIVE_CALL_ALLOWED_ORIGINS=chrome-extension://*,http://127.0.0.1,http://localhost

# Audio contract
LIVE_CALL_SAMPLE_RATE=16000
LIVE_CALL_CHANNELS=1
